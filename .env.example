# Copia este archivo a .env y cambia los valores:
#   cp .env.example .env
# El archivo .env NO se sube a GitHub (esta en .gitignore).

# Puerto publico del proxy inverso (Nginx)
PROXY_HTTP_PORT=8080

# PostgreSQL (solo accesible desde la red interna "backend")
POSTGRES_DB=infralab
POSTGRES_USER=infralab
POSTGRES_PASSWORD=change-me-please

# Grafana (accesible en http://localhost:8080/grafana/)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
