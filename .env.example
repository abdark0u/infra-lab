# Plantilla de variables. Para crear tu .env:
#   make env                -> la copia y pone contraseñas aleatorias (lo más cómodo)
#   cp .env.example .env    -> copia a mano (y entonces cambias tú las contraseñas)
# El .env nunca se sube a GitHub (está en .gitignore): las credenciales no pintan
# nada en un repo público.

# Puerto del proxy inverso (Nginx), el único que se publica en el host
PROXY_HTTP_PORT=8080

# PostgreSQL (solo se llega desde la red interna "backend")
POSTGRES_DB=infralab
POSTGRES_USER=infralab
POSTGRES_PASSWORD=change-me-please

# Grafana (está en http://localhost:8080/grafana/)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
